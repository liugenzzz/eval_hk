      {
        "key": "task_type",
        "from": "task_type"
      },
      {
        "key": "defect_type",
        "from": "meta.defect_type",
        "min_n": 30
      },
      {
        "key": "source_dataset",
        "from": "meta.source_dataset",
        "min_n": 30
      },
      {
        "key": "domain",
        "from": "meta.domain",
        "min_n": 30
      },
      {
        "key": "size_bucket",
        "from": "meta.size_bucket",
        "only_kinds": [
          "aircraft_grounding"
        ]
      },
      {
        "key": "image_status",
        "from": "meta.image_status",
        "only_kinds": [
          "aircraft_presence"
        ]
      }
    ],
    "dataset_weights": {
      "aircraft_presence": 0.2,
      "aircraft_category": 0.2,
      "aircraft_grounding": 0.2,
      "aircraft_refusal": 0.2,
