{
  "datasets": {
    "book_vqa": {
      "name": "book_vqa",
      "kind": "judge_text",
      "params": {
        "category_field": "category",
        "default_category": "未分类"
      }
    }
  },
  "enabled_datasets": [
    "book_vqa"
  ],
  "infer": {
    "prompt_file": "prompts/infer_vqa_raw.txt",
    "max_new_tokens": 1024
  },
  "judge": {
    "prompt_files": {
      "pointwise": "prompts/judge_doc_pointwise_v2.txt",
      "pairwise": "prompts/judge_doc_pairwise_v1.txt"
    }
  },
  "report": {
    "dims": [
      {
        "key": "category",
        "from": "category",
        "min_n": 10
      }
    ]
  },
  "min_category_n": 10,
  "category_weights": {
    "共性基础": 1.0,
    "研发设计": 1.0,
    "生产制造": 1.0,
    "试验测试": 1.0,
    "维修保障": 1.0,
    "运营管理": 1.0,
    "作战应用": 1.0
  }
}
