{
  "convert": {
    "input_json": "data/sharegpt_vqa.json"
  },
  "tsv_dir": "data/tsv",
  "datasets": {
    "mcq": "aero_mcq",
    "judge": "aero_judge",
    "vqa": "aero_vqa"
  },
  "enabled_datasets": [
    "mcq",
    "judge",
    "vqa"
  ],
  "work_dir": "work_dir",
  "out_dir": "eval_report",
  "cache_dir": "eval_cache",
  "models": [
    {
      "name": "base",
      "model_path": "models/Qwen3-VL-8B-Instruct"
    },
    {
      "name": "sft_ep2",
      "model_path": "models/sft_ep2"
    }
  ],
  "baseline_model": "base",
  "infer": {
    "prompt_files": {
      "mcq": "prompts/infer_mcq.txt",
      "judge": "prompts/infer_judge.txt",
      "vqa": "prompts/infer_vqa_raw.txt"
    },
    "max_new_tokens": 1024,
    "batch_size": 1,
    "gpu_ids": [],
    "workers_per_gpu": 1,
    "torch_dtype": "auto",
    "device_map": "auto"
  },
  "judge": {
    "api_base": "http://127.0.0.1:18180/v1/chat/completions",
    "api_key": "sk-local",
    "model": "qwen3.6-27b",
    "temperature": 0.0,
    "timeout": 120,
    "max_retries": 3,
    "prompt_files": {
      "pointwise": "prompts/judge_equip_pointwise_v4.txt",
      "pairwise": "prompts/judge_equip_pairwise.txt"
    }
  },
  "max_workers": 8,
  "do_pointwise": true,
  "do_pairwise": true,
  "do_length_control": true,
  "mcq_llm_extract_fallback": false,
  "bootstrap_n": 1000,
  "seed": 42,
  "category_weights": {
    "P1": 1.0,
    "P2": 1.0,
    "P3": 1.0,
    "R1": 1.0,
    "R2": 1.0,
    "R3": 1.0
  }
}
